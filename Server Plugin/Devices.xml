<?xml version="1.0" encoding="UTF-8"?>
<Devices>
    <Device type="custom" id="airfoilSatelliteMonitor">
        <Name>Airfoil Satellite Monitor</Name>
        <Description>Monitors Airfoil Satellite connection, streaming, artwork availability, match conditions, durations, and now-playing metadata using the app's AppleScript dictionary.</Description>
        <UiDisplayStateId>displayState</UiDisplayStateId>
        <ConfigUI>
            <Field id="updateFrequency" type="menu" defaultValue="5">
                <Label>Poll Interval</Label>
                <List>
                    <Option value="1">Every 1 second</Option>
                    <Option value="2">Every 2 seconds</Option>
                    <Option value="5">Every 5 seconds</Option>
                    <Option value="10">Every 10 seconds</Option>
                    <Option value="30">Every 30 seconds</Option>
                </List>
            </Field>

            <Field id="onlyUpdateOnChange" type="checkbox" defaultValue="true">
                <Label>Only Update Indigo on Change</Label>
                <Description>Reduces Event Log chatter by not refreshing duration counters every poll unless something changes.</Description>
            </Field>
            <Field id="updateDurationEveryPoll" type="checkbox" defaultValue="false">
                <Label>Update Durations Every Poll</Label>
                <Description>Enable if you want live connection/streaming duration counters. Leave off to reduce Indigo state updates.</Description>
            </Field>
            <Field id="metadataDebounceSeconds" type="menu" defaultValue="2">
                <Label>Metadata Debounce</Label>
                <Description>Wait for metadata to remain stable before updating Indigo. This helps avoid rapid transient metadata changes.</Description>
                <List>
                    <Option value="0">Off</Option>
                    <Option value="1">1 second</Option>
                    <Option value="2">2 seconds</Option>
                    <Option value="5">5 seconds</Option>
                    <Option value="10">10 seconds</Option>
                </List>
            </Field>
            <Field id="useStateImages" type="checkbox" defaultValue="true">
                <Label>Use Indigo State Images</Label>
                <Description>Update the device icon when Airfoil Satellite connects, disconnects, or streams.</Description>
            </Field>
            <Field id="saveArtwork" type="checkbox" defaultValue="false">
                <Label>Save Artwork TIFF File</Label>
                <Description>When artwork is available, save it as a TIFF file and expose the file path as a device state.</Description>
            </Field>
            <Field id="artistContains" type="textfield" defaultValue="">
                <Label>Artist Contains Match</Label>
                <Description>Optional text. Artist Match turns on when the artist contains this text.</Description>
            </Field>
            <Field id="albumContains" type="textfield" defaultValue="">
                <Label>Album Contains Match</Label>
                <Description>Optional text. Album Match turns on when the album contains this text.</Description>
            </Field>
            <Field id="trackContains" type="textfield" defaultValue="">
                <Label>Track Contains Match</Label>
                <Description>Optional text. Track Match turns on when the track title contains this text.</Description>
            </Field>
            <Field id="nowPlayingContains" type="textfield" defaultValue="">
                <Label>Now Playing Contains Match</Label>
                <Description>Optional text. Now Playing Match turns on when the combined now-playing text contains this text.</Description>
            </Field>
            <Field id="updateVariables" type="checkbox" defaultValue="false">
                <Label>Update Indigo Variables</Label>
                <Description>Create/update Indigo variables with Airfoil Satellite data.</Description>
            </Field>
            <Field id="variablePrefix" type="textfield" defaultValue="AirfoilSatellite">
                <Label>Variable Prefix</Label>
                <Description>Prefix for created variables, such as AirfoilSatelliteTrackTitle.</Description>
            </Field>
        </ConfigUI>
        <States>
            <State id="displayState"><ValueType>String</ValueType><TriggerLabel>Display State</TriggerLabel><ControlPageLabel>Display</ControlPageLabel></State>
            <State id="connected"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Connected</TriggerLabel><ControlPageLabel>Connected</ControlPageLabel></State>
            <State id="streaming"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Streaming</TriggerLabel><ControlPageLabel>Streaming</ControlPageLabel></State>
            <State id="trackTitle"><ValueType>String</ValueType><TriggerLabel>Track Title</TriggerLabel><ControlPageLabel>Track</ControlPageLabel></State>
            <State id="artist"><ValueType>String</ValueType><TriggerLabel>Artist</TriggerLabel><ControlPageLabel>Artist</ControlPageLabel></State>
            <State id="album"><ValueType>String</ValueType><TriggerLabel>Album</TriggerLabel><ControlPageLabel>Album</ControlPageLabel></State>
            <State id="nowPlaying"><ValueType>String</ValueType><TriggerLabel>Now Playing</TriggerLabel><ControlPageLabel>Now Playing</ControlPageLabel></State>
            <State id="artworkAvailable"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Artwork Available</TriggerLabel><ControlPageLabel>Artwork</ControlPageLabel></State>
            <State id="artworkPath"><ValueType>String</ValueType><TriggerLabel>Artwork Path</TriggerLabel><ControlPageLabel>Artwork Path</ControlPageLabel></State>
            <State id="connectedSince"><ValueType>String</ValueType><TriggerLabel>Connected Since</TriggerLabel><ControlPageLabel>Connected Since</ControlPageLabel></State>
            <State id="connectionDuration"><ValueType>String</ValueType><TriggerLabel>Connection Duration</TriggerLabel><ControlPageLabel>Conn Duration</ControlPageLabel></State>
            <State id="connectionDurationSeconds"><ValueType>Number</ValueType><TriggerLabel>Connection Duration Seconds</TriggerLabel><ControlPageLabel>Conn Sec</ControlPageLabel></State>
            <State id="streamingSince"><ValueType>String</ValueType><TriggerLabel>Streaming Since</TriggerLabel><ControlPageLabel>Streaming Since</ControlPageLabel></State>
            <State id="streamingDuration"><ValueType>String</ValueType><TriggerLabel>Streaming Duration</TriggerLabel><ControlPageLabel>Stream Duration</ControlPageLabel></State>
            <State id="streamingDurationSeconds"><ValueType>Number</ValueType><TriggerLabel>Streaming Duration Seconds</TriggerLabel><ControlPageLabel>Stream Sec</ControlPageLabel></State>
            <State id="lastConnectedStarted"><ValueType>String</ValueType><TriggerLabel>Last Connected Started</TriggerLabel><ControlPageLabel>Conn Started</ControlPageLabel></State>
            <State id="lastConnectedStopped"><ValueType>String</ValueType><TriggerLabel>Last Connected Stopped</TriggerLabel><ControlPageLabel>Conn Stopped</ControlPageLabel></State>
            <State id="lastStreamingStarted"><ValueType>String</ValueType><TriggerLabel>Last Streaming Started</TriggerLabel><ControlPageLabel>Stream Started</ControlPageLabel></State>
            <State id="lastStreamingStopped"><ValueType>String</ValueType><TriggerLabel>Last Streaming Stopped</TriggerLabel><ControlPageLabel>Stream Stopped</ControlPageLabel></State>
            <State id="streamingStartCounter"><ValueType>Number</ValueType><TriggerLabel>Streaming Start Counter</TriggerLabel><ControlPageLabel>Stream Starts</ControlPageLabel></State>
            <State id="streamingStopCounter"><ValueType>Number</ValueType><TriggerLabel>Streaming Stop Counter</TriggerLabel><ControlPageLabel>Stream Stops</ControlPageLabel></State>
            <State id="lastConnectedChange"><ValueType>String</ValueType><TriggerLabel>Last Connection Change</TriggerLabel><ControlPageLabel>Connection Changed</ControlPageLabel></State>
            <State id="lastStreamingChange"><ValueType>String</ValueType><TriggerLabel>Last Streaming Change</TriggerLabel><ControlPageLabel>Streaming Changed</ControlPageLabel></State>
            <State id="lastMetadataChange"><ValueType>String</ValueType><TriggerLabel>Last Metadata Change</TriggerLabel><ControlPageLabel>Metadata Changed</ControlPageLabel></State>
            <State id="lastMetadataUpdate"><ValueType>String</ValueType><TriggerLabel>Last Metadata Update</TriggerLabel><ControlPageLabel>Metadata Update</ControlPageLabel></State>
            <State id="metadataChangeCounter"><ValueType>Number</ValueType><TriggerLabel>Metadata Change Counter</TriggerLabel><ControlPageLabel>Metadata Count</ControlPageLabel></State>
            <State id="artistMatch"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Artist Match</TriggerLabel><ControlPageLabel>Artist Match</ControlPageLabel></State>
            <State id="albumMatch"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Album Match</TriggerLabel><ControlPageLabel>Album Match</ControlPageLabel></State>
            <State id="trackMatch"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Track Match</TriggerLabel><ControlPageLabel>Track Match</ControlPageLabel></State>
            <State id="nowPlayingMatch"><ValueType boolType="OnOff">Boolean</ValueType><TriggerLabel>Now Playing Match</TriggerLabel><ControlPageLabel>NP Match</ControlPageLabel></State>
            <State id="lastError"><ValueType>String</ValueType><TriggerLabel>Last Error</TriggerLabel><ControlPageLabel>Last Error</ControlPageLabel></State>
        </States>
    </Device>
</Devices>
